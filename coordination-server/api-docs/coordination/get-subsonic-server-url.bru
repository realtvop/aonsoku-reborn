meta {
  name: Get Subsonic Server Info
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/subsonic
}

tests {
  test("returns url and reverseProxyEnabled", function() {
    expect(res.status).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("url");
    expect(body).to.have.property("reverseProxyEnabled");
  });
}
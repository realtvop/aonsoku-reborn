{
  "name": "@aonsoku/capacitor-native",
  "version": "0.0.0",
  "description": "Unified Capacitor native plugin for Aonsoku iOS/Android — bridge, data, audio, preferences, and coordination.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge/index.ts",
    "./data": "./src/data/index.ts",
    "./audio": "./src/audio/index.ts",
    "./preferences": "./src/preferences/index.ts",
    "./coordination": "./src/coordination/index.ts"
  },
  "files": ["ios/Sources", "src", "Package.swift"],
  "dependencies": {
    "@aonsoku/audio-contract": "workspace:*"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}

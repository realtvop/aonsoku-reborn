{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aonsoku-coordination",
  "main": "coordination-worker/src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountCoordinator"] }],
  "vars": {
    "ALLOWED_IDENTITY_ORIGINS": "",
    "ENABLE_OFFLINE_HANDOFF": "",
    "MAX_DEVICES": ""
  },
  "secrets": {
    "required": ["STABLE_KEY"]
  }
}

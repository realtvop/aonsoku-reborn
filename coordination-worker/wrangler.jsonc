{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aonsoku-coordination",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountCoordinator"] }],
  "vars": {
    "ALLOWED_IDENTITY_ORIGINS": "https://navidrome.example.com"
  }
}
